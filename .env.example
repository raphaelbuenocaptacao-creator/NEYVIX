# NEYVIX App
NEXT_PUBLIC_APP_NAME=NEYVIX
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRIMARY_DOMAIN=neyvix.com

# Database (provision through Vercel + Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret

# Mail transport (provider to be selected before real delivery)
MAIL_FROM_DOMAIN=neyvix.com
MAIL_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Optional integrations
AI_API_KEY=
STORAGE_TOKEN=
