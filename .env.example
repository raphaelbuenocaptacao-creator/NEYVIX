# NEYVIX App
NEXT_PUBLIC_APP_NAME=NEYVIX
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRIMARY_DOMAIN=neyvix.com

# Database — use a database dedicated exclusively to NEYVIX.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neyvix?sslmode=require

# Authentication — generate a long random secret for production.
NEYVIX_SESSION_SECRET=replace-with-a-long-random-secret

# Commercial / plans
# Keep false until 006_commercial.sql is applied and payment flows are validated.
NEYVIX_ENFORCE_PLANS=false
NEYVIX_PAYMENT_PROVIDER=
# Optional hosted checkout URLs. Must use HTTPS.
NEYVIX_CHECKOUT_START_URL=
NEYVIX_CHECKOUT_PRO_URL=
NEYVIX_CHECKOUT_BUSINESS_URL=

# NEYVIX AI — HTTPS endpoint that receives POST { prompt, context }.
NEYVIX_AI_GATEWAY_URL=https://your-ai-gateway.example.com/webhook/neyvix
NEYVIX_AI_GATEWAY_SECRET=replace-with-a-long-random-gateway-secret

# Mail transport (provider to be selected before real delivery)
MAIL_FROM_DOMAIN=neyvix.com
MAIL_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Optional integrations
AI_API_KEY=
STORAGE_TOKEN=
